# Переменные docker compose. Скопировать в deploy/.env и заполнить.
# Файл с реальными значениями в репозиторий не коммитится.

# Кластер YTsaurus
YT_PROXY=https://your-cluster.example.com/
YT_TOKEN=

# Ключи JavaScript API Яндекс Карт через запятую, без пробелов. У бесплатного
# ключа лимит 100 загрузок карты в сутки; фронтенд берёт случайный ключ из
# списка при каждой загрузке страницы, поэтому лимит умножается на их число.
# Значение попадает в бандл на сборке, поэтому смена ключей требует
# пересборки образа web.
# В кабинете КАЖДОГО ключа адрес сайта должен быть в «Ограничение по HTTP
# Referer»; голый IP там не принимается, нужен домен.
VITE_YMAPS_API_KEY=

# Адрес сайта для Caddy. С префиксом http:// сертификат не запрашивается.
# Без префикса Caddy пойдёт за сертификатом Let's Encrypt на этот домен.
DOMAIN=http://203.0.113.12.nip.io
ACME_EMAIL=team12@example.com
