# Переменные docker compose. Скопировать в deploy/.env и заполнить.
# Файл с реальными значениями в репозиторий не коммитится.

# Кластер YTsaurus
YT_PROXY=https://your-cluster.example.com/
YT_TOKEN=

# Ключ JavaScript API Яндекс Карт. У бесплатного ключа лимит 100 загрузок
# карты в сутки. Значение попадает в бандл на сборке, поэтому смена ключа
# требует пересборки образа web.
# В кабинете ключа адрес сайта должен быть в «Ограничение по HTTP Referer»;
# голый IP там не принимается, нужен домен.
VITE_YMAPS_API_KEY=

# Адрес сайта для Caddy. Сертификат приезжает из Certificate Manager файлами
# в /opt/wikipulse/certs (см. README, раздел «Сертификат»).
DOMAIN=example.com
ACME_EMAIL=team12@example.com
